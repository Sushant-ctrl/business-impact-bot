# Copy to .env and fill in. .env is git-ignored.
OPENROUTER_API_KEY=
# Any OpenRouter model id, e.g. anthropic/claude-sonnet-5.5, anthropic/claude-haiku-5.5, openai/gpt-5-mini
OPENROUTER_MODEL=anthropic/claude-sonnet-5.5

# Pine Labs AgenticOrg (governed agents). Key needs the agents:run scope.
AGENTICORG_API_KEY=
# AGENTICORG_BASE_URL=https://agenticorg.hackathon.pinelabs.com
# AGENTICORG_ALLOCATION_AGENT_ID=60201cd3-74b3-4a53-a762-fbb7b1bce836
# AGENTICORG_DISRUPTION_AGENT_ID=82c0d41d-ab8c-4d64-877c-4b5317b8ba21

PORT=8787
# DATABASE_PATH=./data/recoverroute.db
